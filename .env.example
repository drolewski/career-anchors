# Supabase Configuration
# Create a free project at https://supabase.com
# Then go to Settings > API to get your keys

# Client-side (exposed to browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only (NEVER prefix with VITE_ - would leak to client)
# Used by api/keep-alive.js Vercel Cron Job to prevent Supabase free tier pause.
# Set these in Vercel Dashboard > Project Settings > Environment Variables (Production only).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
