# Optional: leave blank to run the questionnaire locally without a database.
# Use a separate development project with synthetic data only.
# VITE_* values are public and included in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional legacy Vercel keep-alive endpoint; server-side only.
# Never prefix a service-role key with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
